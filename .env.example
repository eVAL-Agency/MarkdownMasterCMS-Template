# MarkdownMasterCMS Environment Configuration
# Copy this file to .env and configure as needed
#
# Please note, this file is **NOT** required for site operation!
# This is **ONLY** used for scripts/ usage in development.
#
# Update Mode (for update.sh)
#   stable  - Download latest release from GitHub
#   unstable - Download from markdownmaster.com/build/
UPDATE_SOURCE=stable

# Deployment Configuration (for deploy.sh)
# Set DEPLOY_MODE to 'remote' for production deployments
DEPLOY_MODE=local

# Remote server configuration (required when DEPLOY_MODE=remote)
DEPLOY_HOST=localhost
DEPLOY_USER=root

# Deploy target, needed for both local and remote
DEPLOY_PATH=/var/www/html/markdownmaster
